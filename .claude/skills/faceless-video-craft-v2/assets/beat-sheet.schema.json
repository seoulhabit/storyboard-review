{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faceless-video-craft beat sheet",
  "type": "object",
  "required": [
    "slug",
    "format",
    "fps",
    "canvas",
    "vo_duration_s",
    "presenter",
    "sections",
    "scenes",
    "chapters"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "format": {
      "enum": [
        "long",
        "short"
      ]
    },
    "fps": {
      "enum": [
        30,
        60
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        }
      }
    },
    "vo_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Measured voiceover duration \u2014 the master clock."
    },
    "presenter": {
      "enum": [
        "moving-diagram",
        "data-object",
        "kinetic-type",
        "photographic-plate"
      ]
    },
    "sections": {
      "type": "array",
      "description": "The six-section spine with resolved start times.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "start",
          "end"
        ],
        "properties": {
          "name": {
            "enum": [
              "hook",
              "misconception",
              "mechanism",
              "proof",
              "application",
              "recap"
            ]
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "duration",
          "section",
          "layout",
          "beats"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "section": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "description": "Grid/Flex strategy in one line, e.g. 'grid 60/40, plate left, type right'"
          },
          "plate": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project-relative path to the plate, or null for browser-drawn. Never an absolute or file:// path."
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "offset",
                "intent"
              ],
              "properties": {
                "offset": {
                  "type": "number",
                  "minimum": 0
                },
                "dur": {
                  "type": "number"
                },
                "intent": {
                  "type": "string",
                  "description": "A visual state, not a sentence."
                },
                "caption": {
                  "type": "string"
                },
                "easing": {
                  "enum": [
                    "arrive",
                    "camera",
                    "linear",
                    "snap"
                  ],
                  "description": "Mapped to a GSAP ease by the generator. Never one easing for everything."
                },
                "text": {
                  "type": "string",
                  "description": "The on-screen type for this beat. Falls back to `caption`, then `intent`."
                },
                "role": {
                  "enum": [
                    "head",
                    "sub",
                    "body",
                    "kicker",
                    "caption",
                    "stat",
                    "flag",
                    "cite"
                  ],
                  "description": "Type role; drives the class and therefore the type floor."
                }
              }
            }
          },
          "bg": {
            "type": "string",
            "description": "This scene's ground. A boundary between two different grounds is a hard cut."
          },
          "accent": {
            "type": "string"
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "title"
        ],
        "properties": {
          "t": {
            "type": "number"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "end_scene": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "overlay_zones_clear": {
          "type": "boolean"
        }
      }
    },
    "bg": {
      "type": "string",
      "description": "Default canvas background (hex). Per-scene `bg` overrides it."
    },
    "ink": {
      "type": "string",
      "description": "Body/heading text colour (hex)."
    },
    "accent": {
      "type": "string",
      "description": "Default accent (hex). Exactly one accent per frame [S6/A-2]."
    },
    "fonts": {
      "type": "object",
      "description": "A named Google Fonts family is the engine-supported path: the compiler injects deterministic @font-face at render time.",
      "properties": {
        "family": {
          "type": "string"
        },
        "css": {
          "type": "string",
          "description": "The CSS font-family stack, including fallbacks."
        },
        "google_css2": {
          "type": "string",
          "description": "https://fonts.googleapis.com/css2?family=... stylesheet URL."
        }
      }
    },
    "safe_area": {
      "type": "object",
      "description": "Safe-area insets in px. Declared here and CONSUMED as .stage padding by the generator.",
      "properties": {
        "top": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        },
        "right": {
          "type": "integer"
        },
        "left": {
          "type": "integer"
        }
      }
    },
    "audio": {
      "type": "object",
      "description": "Optional bed mounted on the root. Plain data-volume only \u2014 a data-automation lane REPLACES it on this engine.",
      "properties": {
        "src": {
          "type": "string",
          "description": "Project-relative path, e.g. assets/bgm/track.mp3"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.98
        }
      }
    },
    "muted": {
      "type": "string",
      "description": "Muted ink for disclosure flags. Never the accent \u2014 a flag in the accent colour reads as a citation."
    }
  }
}
