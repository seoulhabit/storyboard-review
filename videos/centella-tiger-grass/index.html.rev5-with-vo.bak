<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=EB+Garamond:ital@0;1&family=Noto+Sans+KR:wght@500;700&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000; }
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: #101314; }
      .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
      .clip { position: absolute; }
      /* Burned-in captions v2 (rework brief): dynamic 2-4 word groups, center-lower
         band y 1064-1170 (BLOCKER fix: layer shifted up 20% clear of the Shorts title/description UI) — visually lower-third but above the Shorts bottom-20% UI
         strip. Keyword per group tinted celadon-bright. Pop-in driven by the main
         timeline (seek-safe). */
      .vo-caption { top: 1064px; left: 0; width: 100%; display: flex; justify-content: center; z-index: 60; pointer-events: none; }
      .vo-caption span { display: inline-block; max-width: 860px; background: rgba(19,21,22,0.92); color: #F7F5F0;
        font-family: 'Inter', 'Helvetica Neue', sans-serif; font-weight: 800; font-size: 54px; line-height: 1.25;
        text-align: center; padding: 16px 34px; border-radius: 18px; box-shadow: 0 4px 18px rgba(19,21,22,0.25); }
      .vo-caption em { font-style: normal; color: #93B896; }
      .ic { inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 55;
        filter: saturate(1.12) contrast(1.05); background: #101314; }
    </style>
  </head>
  <body>
    <!--
      Timing: every beat duration is its real installed VO length (assets/voice/0N.wav,
      post audio-gate) plus a settle tail; all inner .clip data-duration values are synced
      to their beat totals at authoring time (PDRN inner/outer duration defect class).
      VO starts: 01=0.150 02=7.348 03=16.498 04=25.151 05=39.101 06=49.768 07=60.167.
      Scene starts: S1=0 S2=5.000 S3=16.348 S4=25.001 S5=38.951 S6=49.618 S7=60.017.
      Total 72.000s (out point trimmed 1.0s per QC — loop-out retimed to land by 72.0). Beat-5 VO says "fibroblast cells" (articulation retake — plural
      cluster slurred in 5 takes; see BRIEF.md); captions match the spoken take.
    -->
    <div id="root" data-composition-id="main" data-start="0.000" data-duration="72.000" data-width="1080" data-height="1920">
      <div id="el-01-hook" class="scene" data-composition-id="01-hook" data-composition-src="compositions/frames/01-hook.html" data-start="0.000" data-duration="5.000" data-track-index="0"></div>
      <audio id="el-01-voice" src="assets/voice/01.wav" data-start="0.150" data-duration="6.848" data-track-index="10" data-volume="1"></audio>

      <div id="el-02-identity" class="scene" data-composition-id="02-identity" data-composition-src="compositions/frames/02-identity.html" data-start="5.000" data-duration="11.348" data-track-index="1"></div>
      <audio id="el-02-voice" src="assets/voice/02.wav" data-start="7.348" data-duration="8.800" data-track-index="10" data-volume="1"></audio>

      <div id="el-03-compounds" class="scene" data-composition-id="03-compounds" data-composition-src="compositions/frames/03-compounds.html" data-start="16.348" data-duration="8.653" data-track-index="0"></div>
      <audio id="el-03-voice" src="assets/voice/03.wav" data-start="16.498" data-duration="8.303" data-track-index="10" data-volume="1"></audio>

      <div id="el-04-mechanism" class="scene" data-composition-id="04-mechanism" data-composition-src="compositions/frames/04-mechanism.html" data-start="25.001" data-duration="13.950" data-track-index="1"></div>
      <audio id="el-04-voice" src="assets/voice/04.wav" data-start="25.151" data-duration="13.600" data-track-index="10" data-volume="1"></audio>

      <div id="el-05-fibroblast" class="scene" data-composition-id="05-fibroblast" data-composition-src="compositions/frames/05-fibroblast.html" data-start="38.951" data-duration="10.667" data-track-index="0"></div>
      <audio id="el-05-voice" src="assets/voice/05.wav" data-start="39.101" data-duration="10.317" data-track-index="10" data-volume="1"></audio>

      <div id="el-06-protocol" class="scene" data-composition-id="06-protocol" data-composition-src="compositions/frames/06-protocol.html" data-start="49.618" data-duration="10.399" data-track-index="1"></div>
      <audio id="el-06-voice" src="assets/voice/06.wav" data-start="49.768" data-duration="10.049" data-track-index="10" data-volume="1"></audio>

      <div id="el-07-cta" class="scene" data-composition-id="07-cta" data-composition-src="compositions/frames/07-cta.html" data-start="60.017" data-duration="11.983" data-track-index="0"></div>
      <audio id="el-07-voice" src="assets/voice/07.wav" data-start="60.167" data-duration="11.150" data-track-index="10" data-volume="1"></audio>

      <!-- Captions v2 — whisper word-timed, 2-4 word groups, keyword tinted -->
      <div id="cap-01" class="clip vo-caption" data-start="0.150" data-duration="1.010" data-track-index="5"><span>Wounded <em>tigers</em> were</span></div>
      <div id="cap-02" class="clip vo-caption" data-start="1.160" data-duration="0.790" data-track-index="5"><span>seen rolling in</span></div>
      <div id="cap-03" class="clip vo-caption" data-start="1.950" data-duration="0.750" data-track-index="5"><span>this <em>plant</em> to</span></div>
      <div id="cap-04" class="clip vo-caption" data-start="2.700" data-duration="1.160" data-track-index="5"><span><em>heal</em> their skin.</span></div>
      <div id="cap-05" class="clip vo-caption" data-start="3.860" data-duration="0.580" data-track-index="5"><span><em>Legend?</em></span></div>
      <div id="cap-06" class="clip vo-caption" data-start="4.440" data-duration="0.340" data-track-index="5"><span><em>Maybe,</em></span></div>
      <div id="cap-07" class="clip vo-caption" data-start="4.780" data-duration="0.920" data-track-index="5"><span>but the <em>science</em></span></div>
      <div id="cap-08" class="clip vo-caption" data-start="5.700" data-duration="0.780" data-track-index="5"><span>underneath is very</span></div>
      <div id="cap-09" class="clip vo-caption" data-start="6.480" data-duration="0.720" data-track-index="5"><span><em>real.</em></span></div>
      <div id="cap-10" class="clip vo-caption" data-start="7.498" data-duration="1.350" data-track-index="5"><span>This is <em>Centella</em></span></div>
      <div id="cap-11" class="clip vo-caption" data-start="8.848" data-duration="1.300" data-track-index="5"><span><em>Asiatica.</em></span></div>
      <div id="cap-12" class="clip vo-caption" data-start="10.148" data-duration="1.510" data-track-index="5"><span>K-beauty calls it</span></div>
      <div id="cap-13" class="clip vo-caption" data-start="11.658" data-duration="0.470" data-track-index="5"><span><em>Cica.</em></span></div>
      <div id="cap-14" class="clip vo-caption" data-start="12.128" data-duration="0.420" data-track-index="5"><span>And if your</span></div>
      <div id="cap-15" class="clip vo-caption" data-start="12.548" data-duration="1.080" data-track-index="5"><span>skin <em>barrier</em> is</span></div>
      <div id="cap-16" class="clip vo-caption" data-start="13.628" data-duration="0.590" data-track-index="5"><span><em>wrecked,</em></span></div>
      <div id="cap-17" class="clip vo-caption" data-start="14.218" data-duration="0.270" data-track-index="5"><span>this is the</span></div>
      <div id="cap-18" class="clip vo-caption" data-start="14.488" data-duration="1.020" data-track-index="5"><span><em>ingredient</em> your routine</span></div>
      <div id="cap-19" class="clip vo-caption" data-start="15.508" data-duration="0.830" data-track-index="5"><span>is <em>missing.</em></span></div>
      <div id="cap-20" class="clip vo-caption" data-start="16.498" data-duration="0.750" data-track-index="5"><span>Inside it,</span></div>
      <div id="cap-21" class="clip vo-caption" data-start="17.248" data-duration="1.570" data-track-index="5"><span><em>four</em> active compounds.</span></div>
      <div id="cap-22" class="clip vo-caption" data-start="18.818" data-duration="0.900" data-track-index="5"><span>The <em>star</em> is</span></div>
      <div id="cap-23" class="clip vo-caption" data-start="19.718" data-duration="1.500" data-track-index="5"><span>madecassoside,</span></div>
      <div id="cap-24" class="clip vo-caption" data-start="21.218" data-duration="1.270" data-track-index="5"><span>a <em>molecule</em> your</span></div>
      <div id="cap-25" class="clip vo-caption" data-start="22.488" data-duration="1.250" data-track-index="5"><span><em>inflamed</em> skin has</span></div>
      <div id="cap-26" class="clip vo-caption" data-start="23.738" data-duration="1.350" data-track-index="5"><span>been <em>begging</em> for.</span></div>
      <div id="cap-27" class="clip vo-caption" data-start="25.581" data-duration="0.610" data-track-index="5"><span>Here is the</span></div>
      <div id="cap-28" class="clip vo-caption" data-start="26.191" data-duration="1.910" data-track-index="5"><span><em>mechanism.</em></span></div>
      <div id="cap-29" class="clip vo-caption" data-start="28.101" data-duration="1.440" data-track-index="5"><span>Madecassoside <em>shuts</em> down</span></div>
      <div id="cap-30" class="clip vo-caption" data-start="29.541" data-duration="1.800" data-track-index="5"><span>the <em>inflammatory</em> signals</span></div>
      <div id="cap-31" class="clip vo-caption" data-start="31.341" data-duration="1.430" data-track-index="5"><span>screaming through <em>damaged</em></span></div>
      <div id="cap-32" class="clip vo-caption" data-start="32.771" data-duration="0.480" data-track-index="5"><span>skin.</span></div>
      <div id="cap-33" class="clip vo-caption" data-start="33.251" data-duration="0.770" data-track-index="5"><span><em>Redness,</em></span></div>
      <div id="cap-34" class="clip vo-caption" data-start="34.021" data-duration="1.030" data-track-index="5"><span><em>stinging,</em></span></div>
      <div id="cap-35" class="clip vo-caption" data-start="35.051" data-duration="0.750" data-track-index="5"><span>that <em>hot,</em></span></div>
      <div id="cap-36" class="clip vo-caption" data-start="35.801" data-duration="1.430" data-track-index="5"><span><em>tight</em> feeling.</span></div>
      <div id="cap-37" class="clip vo-caption" data-start="37.231" data-duration="0.750" data-track-index="5"><span>The <em>alarm</em> gets</span></div>
      <div id="cap-38" class="clip vo-caption" data-start="37.981" data-duration="1.180" data-track-index="5"><span><em>switched</em> off.</span></div>
      <div id="cap-39" class="clip vo-caption" data-start="39.391" data-duration="0.430" data-track-index="5"><span>Then it goes</span></div>
      <div id="cap-40" class="clip vo-caption" data-start="39.821" data-duration="0.940" data-track-index="5"><span>further,</span></div>
      <div id="cap-41" class="clip vo-caption" data-start="40.761" data-duration="0.640" data-track-index="5"><span>it wakes up</span></div>
      <div id="cap-42" class="clip vo-caption" data-start="41.401" data-duration="1.530" data-track-index="5"><span>your <em>fibroblast</em> cells,</span></div>
      <div id="cap-43" class="clip vo-caption" data-start="42.931" data-duration="0.660" data-track-index="5"><span>the <em>factories</em> that</span></div>
      <div id="cap-44" class="clip vo-caption" data-start="43.591" data-duration="1.810" data-track-index="5"><span>manufacture <em>collagen,</em></span></div>
      <div id="cap-45" class="clip vo-caption" data-start="45.401" data-duration="0.710" data-track-index="5"><span>and puts them</span></div>
      <div id="cap-46" class="clip vo-caption" data-start="46.111" data-duration="0.950" data-track-index="5"><span>back to work</span></div>
      <div id="cap-47" class="clip vo-caption" data-start="47.061" data-duration="0.870" data-track-index="5"><span><em>rebuilding</em> your skin</span></div>
      <div id="cap-48" class="clip vo-caption" data-start="47.931" data-duration="1.160" data-track-index="5"><span><em>barrier</em> brick by</span></div>
      <div id="cap-49" class="clip vo-caption" data-start="49.091" data-duration="0.460" data-track-index="5"><span><em>brick.</em></span></div>
      <div id="cap-50" class="clip vo-caption" data-start="49.828" data-duration="0.650" data-track-index="5"><span>So here is</span></div>
      <div id="cap-51" class="clip vo-caption" data-start="50.478" data-duration="1.020" data-track-index="5"><span>the <em>protocol.</em></span></div>
      <div id="cap-52" class="clip vo-caption" data-start="51.498" data-duration="0.410" data-track-index="5"><span>If you have</span></div>
      <div id="cap-53" class="clip vo-caption" data-start="51.908" data-duration="1.580" data-track-index="5"><span>been over exfoliating</span></div>
      <div id="cap-54" class="clip vo-caption" data-start="53.488" data-duration="1.200" data-track-index="5"><span><em>stop</em> shelve the</span></div>
      <div id="cap-55" class="clip vo-caption" data-start="54.688" data-duration="0.920" data-track-index="5"><span>harsh <em>acids</em> for</span></div>
      <div id="cap-56" class="clip vo-caption" data-start="55.608" data-duration="0.660" data-track-index="5"><span>two <em>weeks</em> and</span></div>
      <div id="cap-57" class="clip vo-caption" data-start="56.268" data-duration="0.620" data-track-index="5"><span><em>replace</em> them with</span></div>
      <div id="cap-58" class="clip vo-caption" data-start="56.888" data-duration="0.880" data-track-index="5"><span>a <em>Cica</em> serum</span></div>
      <div id="cap-59" class="clip vo-caption" data-start="57.768" data-duration="1.200" data-track-index="5"><span>or <em>cream</em> morning</span></div>
      <div id="cap-60" class="clip vo-caption" data-start="58.968" data-duration="0.940" data-track-index="5"><span>and <em>night.</em></span></div>
      <div id="cap-61" class="clip vo-caption" data-start="60.447" data-duration="0.520" data-track-index="5"><span>Drop a <em>tiger</em></span></div>
      <div id="cap-62" class="clip vo-caption" data-start="60.967" data-duration="0.800" data-track-index="5"><span><em>emoji</em> in the</span></div>
      <div id="cap-63" class="clip vo-caption" data-start="61.767" data-duration="1.100" data-track-index="5"><span><em>comments</em> if your</span></div>
      <div id="cap-64" class="clip vo-caption" data-start="62.867" data-duration="0.950" data-track-index="5"><span>skin <em>barrier</em> needs</span></div>
      <div id="cap-65" class="clip vo-caption" data-start="63.817" data-duration="0.830" data-track-index="5"><span><em>rescuing,</em></span></div>
      <div id="cap-66" class="clip vo-caption" data-start="64.647" data-duration="0.670" data-track-index="5"><span>and <em>follow</em> for</span></div>
      <div id="cap-67" class="clip vo-caption" data-start="65.317" data-duration="0.820" data-track-index="5"><span>the next <em>ingredient</em></span></div>
      <div id="cap-68" class="clip vo-caption" data-start="66.137" data-duration="0.800" data-track-index="5"><span><em>breakdown.</em></span></div>
      <div id="cap-69" class="clip vo-caption" data-start="66.937" data-duration="1.040" data-track-index="5"><span>Your skin <em>heals</em></span></div>
      <div id="cap-70" class="clip vo-caption" data-start="67.977" data-duration="0.830" data-track-index="5"><span>itself.</span></div>
      <div id="cap-71" class="clip vo-caption" data-start="68.807" data-duration="1.120" data-track-index="5"><span>Cica just hands</span></div>
      <div id="cap-72" class="clip vo-caption" data-start="69.927" data-duration="1.060" data-track-index="5"><span>it the <em>tools.</em></span></div>

      <!-- G5 full-screen botanical intercuts at scene boundaries (graded like the hook) -->
      <video id="ic-1" class="clip ic" src="assets/plates/broll-1.mp4" muted playsinline data-start="5.000" data-duration="0.800" data-media-start="1.5" data-track-index="40"></video>
      <video id="ic-2" class="clip ic" src="assets/plates/broll-3.mp4" muted playsinline data-start="16.348" data-duration="0.800" data-media-start="1.5" data-track-index="40"></video>
      <video id="ic-3" class="clip ic" src="assets/plates/broll-4.mp4" muted playsinline data-start="25.001" data-duration="0.800" data-media-start="1.2" data-track-index="40"></video>
      <video id="ic-4" class="clip ic" src="assets/plates/broll-5.mp4" muted playsinline data-start="38.951" data-duration="0.850" data-media-start="1.5" data-track-index="40"></video>
      <video id="ic-5" class="clip ic" src="assets/plates/broll-2.mp4" muted playsinline data-start="49.618" data-duration="0.800" data-media-start="1.5" data-track-index="40"></video>
      <video id="ic-6" class="clip ic" src="assets/plates/broll-6.mp4" muted playsinline data-start="60.017" data-duration="0.800" data-media-start="2.0" data-track-index="40"></video>

      <!-- BGM — quiet bed, ducked well beneath narration -->
      <audio id="el-bgm" src="assets/bgm/track-soft.mp3" data-start="0.000" data-duration="72.000" data-track-index="11" data-volume="0.045"></audio>

      <!-- SFX — same asset vocabulary as pdrn/red-ginseng (see STORYBOARD.md map) -->
      <audio id="el-sfx-1a" src="assets/sfx/impact-bass-1.mp3" data-start="0.000" data-duration="2.116" data-track-index="20" data-volume="0.35"></audio>
      <audio id="el-sfx-1b" src="assets/sfx/whoosh-short.mp3" data-start="4.750" data-duration="0.575" data-track-index="21" data-volume="0.3"></audio>
      <audio id="el-sfx-2a" src="assets/sfx/click-soft.mp3" data-start="7.600" data-duration="0.366" data-track-index="22" data-volume="0.3"></audio>
      <audio id="el-sfx-3a" src="assets/sfx/click-soft.mp3" data-start="17.350" data-duration="0.366" data-track-index="23" data-volume="0.24"></audio>
      <audio id="el-sfx-3b" src="assets/sfx/click-soft.mp3" data-start="17.700" data-duration="0.366" data-track-index="24" data-volume="0.24"></audio>
      <audio id="el-sfx-3c" src="assets/sfx/click-soft.mp3" data-start="18.050" data-duration="0.366" data-track-index="25" data-volume="0.24"></audio>
      <audio id="el-sfx-3d" src="assets/sfx/click-soft.mp3" data-start="18.400" data-duration="0.366" data-track-index="26" data-volume="0.24"></audio>
      <audio id="el-sfx-3e" src="assets/sfx/click-soft.mp3" data-start="19.250" data-duration="0.366" data-track-index="27" data-volume="0.32"></audio>
      <audio id="el-sfx-4a" src="assets/sfx/glitch-3.mp3" data-start="28.600" data-duration="1.400" data-track-index="28" data-volume="0.26"></audio>
      <audio id="el-sfx-4b" src="assets/sfx/click-soft.mp3" data-start="30.900" data-duration="0.366" data-track-index="29" data-volume="0.3"></audio>
      <audio id="el-sfx-5a" src="assets/sfx/sparkle.mp3" data-start="41.100" data-duration="1.802" data-track-index="30" data-volume="0.32"></audio>
      <audio id="el-sfx-6a" src="assets/sfx/click-soft.mp3" data-start="53.500" data-duration="0.366" data-track-index="31" data-volume="0.32"></audio>
      <audio id="el-sfx-6b" src="assets/sfx/click-soft.mp3" data-start="56.300" data-duration="0.366" data-track-index="32" data-volume="0.32"></audio>
      <audio id="el-sfx-7a" src="assets/sfx/chime.mp3" data-start="64.900" data-duration="2.500" data-track-index="33" data-volume="0.28"></audio>
      <audio id="el-sfx-7b" src="assets/sfx/whoosh-short.mp3" data-start="71.200" data-duration="0.575" data-track-index="34" data-volume="0.3"></audio>
    </div>
    <script>
      // Root composition owns no motion of its own — scenes register their own paused
      // timelines. An empty paused timeline satisfies the registry contract for "main".
      window.__timelines = window.__timelines || {};
      var mainTl = gsap.timeline({ paused: true });
      document.querySelectorAll('.vo-caption').forEach(function (el) {
        var s = parseFloat(el.getAttribute('data-start'));
        mainTl.fromTo(el.querySelector('span'), { scale: 1.08 }, { scale: 1, duration: 0.12, ease: 'power2.out', immediateRender: false }, s);
      });
      // 10-frame crossfades on the botanical intercuts so scene boundaries stop feeling abrupt.
      document.querySelectorAll('.ic').forEach(function (el) {
        var s = parseFloat(el.getAttribute('data-start'));
        var d = parseFloat(el.getAttribute('data-duration'));
        mainTl.fromTo(el, { opacity: 0 }, { opacity: 1, duration: 0.333, ease: 'none', immediateRender: false }, s);
        mainTl.to(el, { opacity: 0, duration: 0.333, ease: 'none' }, s + d - 0.333);
      });
      window.__timelines['main'] = mainTl;
    </script>
  </body>
</html>
