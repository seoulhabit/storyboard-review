# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/

# storyboard.py / storyline.py generated output — regenerable, and some
# embed base64 video/image data that shouldn't sit in version control.
# Anchored to the repo root so it doesn't also catch hand-authored
# index.html files elsewhere (e.g. catalog/index.html).
/storyboard.html
/storyboard_*.html
/storyline_*.html
/index.html
*.notes.json
*.feedback.json

# HyperFrames per-project local state/caches (regenerable; absent from every
# video/*/ project committed so far — preview server state, media-resolution
# ledger, thumbnail cache, waveform cache).
.hyperframes/
.media/
.thumbnails/
.waveform-cache/

# macOS
.DS_Store
